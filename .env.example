# Google Gemini
GOOGLE_API_KEY=your_google_key_here
# Use a Gemini 2.x model: required for live web grounding (google_search).
LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=models/gemini-embedding-001
# Timezone used to tell the model the current date/time.
ASSISTANT_TIMEZONE=America/Bogota
# Ground conversational answers with Google Search (live web info).
WEB_SEARCH_ENABLED=true

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=memory

# Voice
KOKORO_ENDPOINT=http://localhost:8880/v1/audio/speech
KOKORO_DEFAULT_VOICE=af_heart
FASTER_WHISPER_MODEL=small

# App
VOICE_API_PORT=8000

# Google Gemini
GOOGLE_API_KEY=your_google_key_here
# Use a Gemini 2.x model: required for live web grounding (google_search).
LLM_MODEL=gemini-3.1-flash-lite
EMBEDDING_MODEL=models/gemini-embedding-2
# Timezone used to tell the model the current date/time.
ASSISTANT_TIMEZONE=America/Bogota
# Ground conversational answers with Google Search (live web info).
WEB_SEARCH_ENABLED=true

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=memory
# Vector dimension: 0 = auto-detect from the embedding model (recommended).
QDRANT_VECTOR_SIZE=0

# Conversational long-term memory is OFF (short-term history is enough for a
# phone assistant). The vector store powers the action cache instead.
MEMORY_ENABLED=false
HISTORY_MAX_MESSAGES_PER_SESSION=20

# Action cache ("skill memory"): repeated single-shot, screen-independent
# commands are served from Qdrant without calling the LLM.
SKILLS_ENABLED=true
SKILLS_COLLECTION=skills
SKILLS_HIT_THRESHOLD=0.97
SKILLS_TTL_DAYS=0

# Voice
KOKORO_ENDPOINT=http://localhost:8880/v1/audio/speech
KOKORO_DEFAULT_VOICE=af_heart
FASTER_WHISPER_MODEL=small

# App
VOICE_API_PORT=8000
# Deployment environment. In "production" the gRPC server refuses to start
# without TLS (TLS_CERT_PATH / TLS_KEY_PATH).
APP_ENV=development

# --- Authentication (HU-27 / ATOM-54) ---
# User store (Mongo). With docker-compose this is reachable as the "mongo" host.
MONGO_URL=mongodb://localhost:27017
MONGO_DB=atom
# JWT signing. Default RS256: generate a dev keypair with
#   python scripts/gen_jwt_keys.py
# then point these at the PEM files. For HS256 instead, set JWT_ALGORITHM=HS256
# and a shared JWT_SECRET.
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=secrets/jwt_public.pem
# JWT_SECRET=change-me-only-for-HS256
JWT_ISSUER=atom-agent
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
# Refresh-token store: set to use Redis (multi-instance); else in-memory.
# REDIS_URL=redis://localhost:6379/0
# Google Sign-In: Web client ID used as the ID-token audience (distinct from
# GOOGLE_API_KEY). Leave empty to disable Google login (email/password still works).
# GOOGLE_OAUTH_CLIENT_ID=

# gRPC TLS (required when APP_ENV=production).
# TLS_CERT_PATH=secrets/server.crt
# TLS_KEY_PATH=secrets/server.key
